:root {
--primary:#2563eb;
--dark:#1e3a8a;
--bg:#f1f5f9;
--card:#fff;
--danger:#dc2626;
}
* {
box-sizing:border-box;
margin:0;
padding:0;
font-family:'Segoe UI',Roboto,Arial,sans-serif;
}
body {
background:var(--bg);
color:#1f2937;
}
.topbar {
background:linear-gradient(135deg,var(--dark),var(--primary));
color:#fff;
text-align:center;
padding:28px 16px;
}
.topbar p {
opacity:.85;
margin-top:6px;
}
.container {
max-width:1100px;
margin:24px auto;
padding:0 16px;
}
.controls {
display:flex;
gap:12px;
flex-wrap:wrap;
align-items:center;
margin-bottom:20px;
}
.controls input, .controls select {
padding:10px 12px;
border:1px solid #cbd5e1;
border-radius:8px;
font-size:15px;
}
.controls input {
flex:1;
min-width:200px;
}
.count {
color:#475569;
font-size:14px;
}
.grid {
display:grid;
grid-template-columns:repeat(auto-fill,minmax(250px,1fr));
gap:18px;
}
.card {
background:var(--card);
border-radius:12px;
padding:18px;
box-shadow:0 2px 8px rgba(0,0,0,.08);
transition:transform .2s;
display:flex;
flex-direction:column;
gap:8px;
}
.card:hover {
transform:translateY(-4px);
}
.card .icon {
font-size:34px;
}
.card h3 {
color:var(--dark);
}
.card p {
font-size:14px;
color:#475569;
flex:1;
}
.tag {
display:inline-block;
background:#dbeafe;
color:var(--primary);
padding:3px 10px;
border-radius:20px;
font-size:12px;
font-weight:600;
width:fit-content;
}
.card .row {
display:flex;
gap:8px;
margin-top:6px;
}
.btn {
background:var(--primary);
color:#fff;
border:none;
padding:9px 14px;
border-radius:8px;
cursor:pointer;
font-size:14px;
}
.btn:hover {
background:var(--dark);
}
.btn.outline {
background:#fff;
color:var(--primary);
border:1px solid var(--primary);
}
.btn.danger {
background:var(--danger);
}
.btn.small {
padding:4px 10px;
font-size:12px;
}
.panel {
background:var(--card);
border-radius:12px;
padding:20px;
margin-top:28px;
box-shadow:0 2px 8px rgba(0,0,0,.08);
}
.panel h2 {
color:var(--dark);
margin-bottom:12px;
}
.inline-form {
display:flex;
gap:10px;
flex-wrap:wrap;
margin-bottom:14px;
}
.inline-form input, .inline-form select {
padding:9px;
border:1px solid #cbd5e1;
border-radius:8px;
flex:1;
min-width:140px;
}
.events li {
list-style:none;
padding:10px 12px;
border-left:4px solid var(--primary);
background:#f8fafc;
margin-bottom:8px;
border-radius:6px;
display:flex;
justify-content:space-between;
gap:8px;
}
.modal {
position:fixed;
inset:0;
background:rgba(0,0,0,.55);
display:flex;
align-items:center;
justify-content:center;
padding:16px;
z-index:10;
}
.modal.hidden {
display:none;
}
.modal-box {
background:#fff;
border-radius:14px;
padding:24px;
width:100%;
max-width:520px;
max-height:90vh;
overflow-y:auto;
position:relative;
}
.modal-box h2 {
color:var(--dark);
margin:8px 0;
}
.modal-box h3 {
margin:16px 0 8px;
color:var(--dark);
}
.modal-box .meta {
font-size:13px;
color:#475569;
margin-top:8px;
}
.close {
position:absolute;
top:10px;
right:14px;
border:none;
background:none;
font-size:28px;
cursor:pointer;
}
#memberForm input {
width:100%;
padding:9px;
margin-top:8px;
border:1px solid #cbd5e1;
border-radius:8px;
}
#memberForm input.invalid {
border-color:var(--danger);
}
.err {
color:var(--danger);
font-size:12px;
display:block;
min-height:14px;
}
#memberForm .btn {
margin-top:10px;
}
.members li {
list-style:none;
display:flex;
justify-content:space-between;
align-items:center;
padding:8px 10px;
border-bottom:1px solid #e2e8f0;
font-size:14px;
}
.empty {
color:#94a3b8;
font-style:italic;
padding:8px;
list-style:none;
}
footer {
text-align:center;
padding:20px;
color:#64748b;
font-size:13px;
}
